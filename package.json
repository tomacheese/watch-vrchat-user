{
  "name": "watch-vrchat-user",
  "version": "0.0.0",
  "description": "Monitor VRChat user location changes and send notifications to Discord",
  "homepage": "https://github.com/tomacheese/watch-vrchat-user",
  "bugs": {
    "url": "https://github.com/tomacheese/watch-vrchat-user/issues"
  },
  "license": "MIT",
  "author": "Tomachi <tomachi@tomacheese.com>",
  "private": true,
  "main": "dist/main.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:tomacheese/watch-vrchat-user.git"
  },
  "scripts": {
    "dev": "tsx watch ./src/main.ts",
    "fix": "run-z fix:prettier fix:eslint",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "fix:prettier": "prettier --write src",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "lint:prettier": "prettier --check src",
    "lint:tsc": "tsc",
    "preinstall": "npx only-allow pnpm",
    "start": "tsx ./src/main.ts",
    "test": "jest --runInBand --passWithNoTests --detectOpenHandles --forceExit --coverage"
  },
  "dependencies": {
    "@book000/node-utils": "1.25.62",
    "keyv": "5.6.0",
    "keyv-file": "5.3.5",
    "vrchat": "2.22.8"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.43",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.5",
    "eslint": "10.9.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-promise": "7.3.0",
    "fixpack": "4.0.0",
    "jest": "30.4.2",
    "jest-expect-message": "1.1.3",
    "prettier": "3.9.6",
    "run-z": "2.1.0",
    "ts-jest": "29.4.12",
    "tsx": "4.23.12",
    "typed-emitter": "2.1.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "jest-expect-message"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    }
  },
  "packageManager": "pnpm@11.23.0"
}
